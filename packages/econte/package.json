{
  "name": "@econte/schema",
  "version": "0.1.0",
  "description": "Zod schema and validator for the econte storyboard format — the TypeScript source of truth for docs/schema-spec.md.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "build:schema": "npm run build && node scripts/build-schema.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "validate": "node scripts/validate-cli.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
